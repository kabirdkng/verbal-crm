{
  "name": "verbal-crm",
  "version": "2.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "deploy:check": "node scripts/deploy-check.mjs",
    "worker": "tsx scripts/worker.ts",
    "worker:once": "tsx scripts/worker.ts --once",
    "docker:up": "docker compose up -d postgres redis",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f postgres redis",
    "docker:reset": "docker compose down -v && docker compose up -d postgres redis",
    "docker:app": "docker compose --profile app up --build",
    "docker:worker": "docker compose --profile worker up --build -d worker",
    "docker:stack": "docker compose --profile app --profile worker up --build -d",
    "db:generate": "prisma generate",
    "db:migrate": "node scripts/with-admin-db.mjs migrate",
    "db:migrate:deploy": "node scripts/with-admin-db.mjs migrate:deploy",
    "db:seed": "node scripts/with-admin-db.mjs seed",
    "db:studio": "prisma studio",
    "db:setup": "npm run db:migrate:deploy && npm run db:seed",
    "db:grant-app-role": "docker exec -i verbal-crm-postgres psql -U verbal -d verbal_crm < scripts/grant-app-role.sql",
    "db:rls": "npm run db:migrate:deploy",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "ioredis": "^5.11.1",
    "next": "^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/ioredis": "^4.28.10",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.1",
    "prisma": "^6.19.3",
    "tsx": "^4.23.1",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
