# Copy into Vercel Project → Settings → Environment Variables (Preview + Production as needed)
# Never commit real secrets.

# --- Core modes (staging) ---
NODE_ENV=production
PERSISTENCE_MODE=postgres
QUEUE_MODE=redis
AUTH_ALLOW_HEADERS=false

# --- Neon Postgres ---
# Prefer pooled connection for serverless (Prisma):
# postgresql://USER:PASS@HOST/db?sslmode=require&pgbouncer=true
DATABASE_URL=
# Direct (non-pooled) URL for migrations/seed from CI or laptop:
DATABASE_URL_ADMIN=

# --- Upstash Redis ---
# redis://default:PASSWORD@HOST:6379
REDIS_URL=

# --- Auth ---
# Leave false in staging/production so only cookie sessions work.

# --- WhatsApp ---
WHATSAPP_MODE=meta
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_PHONE_NUMBER_MAP=
WHATSAPP_APP_SECRET=
WHATSAPP_REQUIRE_SIGNATURE=true
WHATSAPP_INLINE_DRAIN=false
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_DEFAULT_ORGANIZATION_ID=
WHATSAPP_GRAPH_API_VERSION=v21.0

# --- AI (xAI / SpaceXAI) ---
AI_MODE=xai
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=grok-4.5
AI_ORG_BUDGET_USD=10

# --- Workers / Cron ---
# Vercel Cron sends Authorization: Bearer $CRON_SECRET
CRON_SECRET=
# Also accepted by drain route:
WORKER_DRAIN_SECRET=
WORKER_BATCH_SIZE=25
