# Auth
AUTH_ALLOW_HEADERS=true
# In production set AUTH_ALLOW_HEADERS=false

# Persistence: memory (default unit tests) | postgres (Docker local / production)
PERSISTENCE_MODE=memory
# Queue: memory | redis
QUEUE_MODE=memory

# Docker local Postgres (docker compose up postgres redis)
DATABASE_URL=postgresql://verbal:verbal@localhost:5432/verbal_crm?schema=public
REDIS_URL=redis://localhost:6379

# WhatsApp (Meta)
WHATSAPP_VERIFY_TOKEN=verbal-crm-dev
WHATSAPP_APP_SECRET=
WHATSAPP_DEFAULT_ORGANIZATION_ID=org_demo

# AI governance
AI_ORG_BUDGET_USD=10

# Workers
WORKER_DRAIN_SECRET=dev-worker-secret
