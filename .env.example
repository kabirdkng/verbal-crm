# Auth
AUTH_ALLOW_HEADERS=true
# In production set AUTH_ALLOW_HEADERS=false

# Persistence: memory (unit tests) | postgres (Docker local / production)
PERSISTENCE_MODE=memory
QUEUE_MODE=memory

# Docker local Postgres
DATABASE_URL=postgresql://verbal_app:verbal@localhost:5432/verbal_crm?schema=public
DATABASE_URL_ADMIN=postgresql://verbal:verbal@localhost:5432/verbal_crm?schema=public
REDIS_URL=redis://localhost:6379

# WhatsApp (Meta Cloud API)
# mock = no network (default local); meta = real Graph API sends
WHATSAPP_MODE=mock
WHATSAPP_VERIFY_TOKEN=verbal-crm-dev
WHATSAPP_APP_SECRET=
# Production defaults: require signature=true, inlineDrain=false
WHATSAPP_REQUIRE_SIGNATURE=false
WHATSAPP_INLINE_DRAIN=true
WHATSAPP_DEFAULT_ORGANIZATION_ID=org_demo
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# JSON map of Meta phone_number_id → organizationId
# WHATSAPP_PHONE_NUMBER_MAP={"10987654321":"org_demo"}
WHATSAPP_GRAPH_API_VERSION=v21.0

# AI (SpaceXAI / xAI)
# mock = local deterministic suggestions; xai = real Grok API
AI_MODE=mock
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=grok-4.5
XAI_MAX_TOKENS=512
XAI_TIMEOUT_MS=60000
XAI_INPUT_USD_PER_1M=2
XAI_OUTPUT_USD_PER_1M=6
AI_ORG_BUDGET_USD=10


# Workers
WORKER_DRAIN_SECRET=dev-worker-secret
WORKER_BATCH_SIZE=50
WORKER_POLL_INTERVAL_MS=1000
# Redis BLPOP wait (seconds); 0 = non-blocking LPOP
WORKER_BLOCKING_POP_SECONDS=0
# WORKER_ONCE=true for one-shot process exit

