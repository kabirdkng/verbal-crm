# Used by docker compose profile "app" and as a reference for host-side .env.local

# Auth
AUTH_ALLOW_HEADERS=true

# Persistence / queue
PERSISTENCE_MODE=postgres
QUEUE_MODE=redis

# App runtime uses non-superuser so FORCE RLS applies
DATABASE_URL=postgresql://verbal_app:verbal@localhost:5432/verbal_crm?schema=public
# Migrations/seed use owner/superuser
DATABASE_URL_ADMIN=postgresql://verbal:verbal@localhost:5432/verbal_crm?schema=public

REDIS_URL=redis://localhost:6379

# WhatsApp — local demo uses mock sender + optional signature
WHATSAPP_MODE=mock
WHATSAPP_VERIFY_TOKEN=verbal-crm-dev
WHATSAPP_APP_SECRET=
WHATSAPP_REQUIRE_SIGNATURE=false
# Prefer false when running `npm run worker` / docker:worker
WHATSAPP_INLINE_DRAIN=true
WHATSAPP_DEFAULT_ORGANIZATION_ID=org_demo
WORKER_BATCH_SIZE=50
WORKER_POLL_INTERVAL_MS=1000
WORKER_BLOCKING_POP_SECONDS=0

WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_PHONE_NUMBER_MAP=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_GRAPH_API_VERSION=v21.0

# AI — mock for local; set AI_MODE=xai + XAI_API_KEY for real suggestions
AI_MODE=mock
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=grok-4.5
AI_ORG_BUDGET_USD=10


# Workers
WORKER_DRAIN_SECRET=dev-worker-secret
