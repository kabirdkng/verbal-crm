// Postgres/Neon target schema (Phase 2+).
// Runtime default remains in-memory until DATABASE_URL + prisma generate are configured.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  aiBudgetUsd Float    @default(10) @map("ai_budget_usd")
  createdAt   DateTime @default(now()) @map("created_at")

  memberships   Membership[]
  contacts      Contact[]
  conversations Conversation[]
  messages      Message[]
  templates     MessageTemplate[]
  notes         Note[]
  broadcasts    Broadcast[]
  automations   AutomationRule[]
  aiUsage       AiUsage[]
  webhookEvents WebhookEvent[]
  auditEvents   AuditEvent[]

  @@map("organizations")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")

  memberships Membership[]
  sessions    Session[]

  @@map("users")
}

model Membership {
  id             String   @id @default(cuid())
  userId         String   @map("user_id")
  organizationId String   @map("organization_id")
  role           String
  createdAt      DateTime @default(now()) @map("created_at")

  user         User         @relation(fields: [userId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@map("memberships")
}

model Session {
  id             String   @id @default(cuid())
  userId         String   @map("user_id")
  organizationId String   @map("organization_id")
  role           String
  expiresAt      DateTime @map("expires_at")
  createdAt      DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("sessions")
}

model Contact {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  fullName       String   @map("full_name")
  phone          String
  email          String?
  tags           String[] @default([])
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization  Organization   @relation(fields: [organizationId], references: [id])
  conversations Conversation[]
  messages      Message[]
  notes         Note[]

  @@unique([organizationId, phone])
  @@index([organizationId])
  @@map("contacts")
}

model Conversation {
  id             String    @id @default(cuid())
  organizationId String    @map("organization_id")
  contactId      String    @map("contact_id")
  phone          String
  status         String    @default("open")
  lastMessageAt  DateTime? @map("last_message_at")
  lastInboundAt  DateTime? @map("last_inbound_at")
  assignedUserId String?   @map("assigned_user_id")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  contact      Contact      @relation(fields: [contactId], references: [id])
  messages     Message[]

  @@index([organizationId, status])
  @@index([organizationId, contactId])
  @@map("conversations")
}

model Message {
  id                String   @id @default(cuid())
  organizationId    String   @map("organization_id")
  conversationId    String   @map("conversation_id")
  contactId         String   @map("contact_id")
  direction         String
  channel           String   @default("whatsapp")
  body              String
  status            String
  providerMessageId String?  @map("provider_message_id")
  templateName      String?  @map("template_name")
  createdByUserId   String?  @map("created_by_user_id")
  createdAt         DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  conversation Conversation @relation(fields: [conversationId], references: [id])
  contact      Contact      @relation(fields: [contactId], references: [id])

  @@unique([organizationId, providerMessageId])
  @@index([organizationId, conversationId])
  @@map("messages")
}

model MessageTemplate {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  name           String
  language       String   @default("en")
  body           String
  status         String   @default("draft")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("message_templates")
}

model Note {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  contactId      String   @map("contact_id")
  authorUserId   String   @map("author_user_id")
  body           String
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  contact      Contact      @relation(fields: [contactId], references: [id])

  @@index([organizationId, contactId])
  @@map("notes")
}

model Broadcast {
  id               String    @id @default(cuid())
  organizationId   String    @map("organization_id")
  name             String
  templateName     String    @map("template_name")
  status           String
  createdByUserId  String    @map("created_by_user_id")
  totalRecipients  Int       @map("total_recipients")
  sentCount        Int       @default(0) @map("sent_count")
  failedCount      Int       @default(0) @map("failed_count")
  createdAt        DateTime  @default(now()) @map("created_at")
  completedAt      DateTime? @map("completed_at")

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@map("broadcasts")
}

model AutomationRule {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  name           String
  enabled        Boolean  @default(true)
  matchKeyword   String   @map("match_keyword")
  templateName   String   @map("template_name")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@map("automation_rules")
}

model WebhookEvent {
  id              String    @id @default(cuid())
  organizationId  String?   @map("organization_id")
  provider        String    @default("whatsapp")
  providerEventId String    @unique @map("provider_event_id")
  status          String
  payload         Json
  errorMessage    String?   @map("error_message")
  createdAt       DateTime  @default(now()) @map("created_at")
  processedAt     DateTime? @map("processed_at")

  organization Organization? @relation(fields: [organizationId], references: [id])

  @@map("webhook_events")
}

model AiUsage {
  id               String   @id @default(cuid())
  organizationId   String   @map("organization_id")
  feature          String
  model            String
  tokensIn         Int      @map("tokens_in")
  tokensOut        Int      @map("tokens_out")
  estimatedCostUsd Float    @map("estimated_cost_usd")
  actorUserId      String   @map("actor_user_id")
  createdAt        DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@map("ai_usage")
}

model AuditEvent {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  action         String
  actorUserId    String   @map("actor_user_id")
  entityType     String   @map("entity_type")
  entityId       String   @map("entity_id")
  metadata       Json?
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@map("audit_events")
}
